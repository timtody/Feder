    },
    "Minimize": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimieren"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        }
      }
    },
    "More": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr"
          }
        }
      }
    },
    "NVIDIA Nemotron tells speakers apart on this iPhone after you stop, much more reliably than the standard model, also when people talk in quick succession. It needs a one-time 100 MB download, which starts automatically on Wi-Fi. Until then the standard model is used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Nemotron unterscheidet nach dem Stoppen auf diesem iPhone die Sprecher, viel zuverlässiger als das Standardmodell, auch wenn schnell abwechselnd gesprochen wird. Dafür ist ein einmaliger Download von 100 MB nötig, der im WLAN automatisch startet. Bis dahin wird das Standardmodell verwendet."
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Name a speaker in a transcript to add them here. Their voice is then recognized in new recordings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benenne einen Sprecher in einem Transkript, um ihn hier hinzuzufügen. Seine Stimme wird dann in neuen Aufnahmen erkannt."
          }
        }
      }
    },
    "Names and terms the transcription often gets wrong.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Begriffe, die die Transkription oft falsch schreibt."
          }
        }
      }
    },
    "Names every turn of this speaker in this transcript.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benennt jeden Beitrag dieses Sprechers in diesem Transkript."
          }
        }
      }
    },
    "Names, products and terms the transcription often gets wrong. Applies from the next recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, Produkte und Begriffe, die die Transkription oft falsch schreibt. Gilt ab der nächsten Aufnahme."
