    "Microphone Access Off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofonzugriff"
          }
        }
      }
    },
    "Microphone access is off. Allow it in Settings to record.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist aus. Erlaube ihn in den Einstellungen, um aufzunehmen."
