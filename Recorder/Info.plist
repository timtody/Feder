<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(FEDER_DISPLAY_NAME)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.timtody.feder</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>feder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_federlink._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Feder shows the calendar event running when you start a recording, to use its name as the transcript's title with a tap, and offers its invitees as speaker names. Everything stays on this iPhone.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Feder uses Face ID to unlock your transcripts when App Lock is on.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Feder finds your Mac on this Wi-Fi to receive the audio of your calls from it. Nothing goes over the internet.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Feder saves where a transcript was started, so you can see and search it later.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Feder uses the microphone to record and transcribe audio. Everything stays on this iPhone.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Feder adds the action items you choose to Reminders and reads none of your other reminders.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
