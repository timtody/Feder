{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feder zeigt das Kalenderereignis, das beim Start der Aufnahme läuft, damit du seinen Namen mit einem Tipp als Titel des Transkripts verwenden kannst, und schlägt die Eingeladenen als Sprechernamen vor. Alles bleibt auf diesem iPhone."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feder verwendet Face ID, um deine Transkripte zu entsperren, wenn die App-Sperre an ist."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feder speichert, wo ein Transkript begonnen wurde, damit du es später sehen und danach suchen kannst."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feder verwendet das Mikrofon, um Audio aufzunehmen und zu transkribieren. Alles bleibt auf diesem iPhone."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feder fügt die Aufgaben, die du auswählst, zu Erinnerungen hinzu und liest keine deiner anderen Erinnerungen."
          }
        }
      }
    }
  },
  "version": "1.0"
}